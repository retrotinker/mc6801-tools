# Build the mc6801-tools User's Manual (needs pandoc and LaTeX).
#
# The instruction set table is generated by running the assembler, and the
# command reference is generated from the manual pages in man/.

PANDOC	= pandoc
PYTHON	= python3
AS01	= ../as/as01

MANPAGES = man/as01.1 man/ld01.1 man/ar01.1 man/objdump01.1 man/objcopy01.1
REFS	= $(MANPAGES:man/%.1=build/%.md)

all: mc6801-tools-manual.pdf

mc6801-tools-manual.pdf: manual.md build/opcodes.md appendix.md $(REFS)
	$(PANDOC) --pdf-engine=pdflatex --top-level-division=chapter \
		-o $@ manual.md build/opcodes.md appendix.md $(REFS)

build/opcodes.md: tools/gen-opcodes.py ../as/keywords.c $(AS01)
	@mkdir -p build
	$(PYTHON) tools/gen-opcodes.py ../as/keywords.c $(AS01) > $@

build/%.md: man/%.1
	@mkdir -p build
	(echo; echo '## $*(1)'; echo; \
	 $(PANDOC) -f man -t markdown --shift-heading-level-by=2 $< | \
	 sed -E 's/^(###+ .*)/\1 {.unnumbered .unlisted}/') > $@

$(AS01):
	$(MAKE) -C ../as

clean:
	rm -rf build

.PHONY: all clean
